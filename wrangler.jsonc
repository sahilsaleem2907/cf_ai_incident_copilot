// Main Worker. Bindings are added by the WP that builds each piece (TASKS.md decisions log);
// the full target config is TDD §5.1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "incident-copilot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*", "/w/*"]
  },
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "incident-copilot", "database_id": "d24601d5-e047-48c8-8d5a-66880d841b40", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "IncidentAgent", "class_name": "IncidentAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IncidentAgent"] }],
  "workflows": [
    { "name": "diagnosis", "binding": "DIAGNOSIS_WORKFLOW", "class_name": "DiagnosisWorkflow" },
    { "name": "watch", "binding": "WATCH_WORKFLOW", "class_name": "WatchWorkflow" }
  ],
  // Due watches are checked every minute (TDD §8.5, D12).
  "triggers": { "crons": ["* * * * *"] },
  "services": [{ "binding": "DEMO", "service": "incident-copilot-demo", "entrypoint": "DemoAdmin" }],
  // TDD §11: probes per hostname, runs per workspace and per visitor IP (bursts; the hourly quotas are in D1), voice.
  "ratelimits": [
    { "name": "PROBE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RUN_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "VOICE_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "RUN_IP_LIMIT", "namespace_id": "1004", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": {
    "DEMO_BASE_URL": "https://incident-copilot-demo.sahilcs1111.workers.dev",
    "AI_GATEWAY_ID": "incident-copilot",
    "LLM_MODE": "live"
  }
}
